---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Compare two "X.Y.Z" version strings; returns >0 when a is newer than b.
function cmpVersion(a: string, b: string): number {
  const pa = a.split(".").map(Number);
  const pb = b.split(".").map(Number);
  for (let i = 0; i < 3; i++) {
    const diff = (pa[i] ?? 0) - (pb[i] ?? 0);
    if (diff !== 0) return diff;
  }
  return 0;
}

// Newest first by date, then by semver so same-day releases (e.g. v0.12.0 and
// v0.12.1 both dated 2026-06-05) order by version instead of falling back to
// the loader's alphabetical filename order, which buried the newer entry.
const entries = (await getCollection("changelog")).sort((a, b) => {
  const byDate = b.data.date.valueOf() - a.data.date.valueOf();
  if (byDate !== 0) return byDate;
  return cmpVersion(b.data.version, a.data.version);
});

// Lightweight inline-markdown renderer for bullet content. The CHANGELOG
// only uses **bold** and `code`; anything else stays literal. HTML is
// escaped first so user content can't inject markup.
function inlineMd(s: string): string {
  const escaped = s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return escaped
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
}

function formatDate(d: Date): string {
  // Use the entry's nominal date (no timezone shift).
  return d.toISOString().slice(0, 10);
}
---

<BaseLayout
  title="Changelog — PQ Companion"
  description="Release notes for PQ Companion. Per-version summary of new features, improvements, and fixes since v0.1.0."
>
  <section class="hero-glow border-b border-border-subtle">
    <div class="mx-auto max-w-4xl px-6 pb-12 pt-20 md:pt-24">
      <p
        class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-primary"
      >
        Changelog
      </p>
      <h1
        class="text-4xl font-bold tracking-tight text-foreground md:text-5xl"
      >
        What's new in PQ Companion
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted-foreground">
        Plain-English summaries of every release. For the full commit-level
        view of any version, follow the GitHub link beside the version
        number.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-4xl px-6">
      <ol class="space-y-10">
        {
          entries.map((entry) => {
            const { version, headline, highlights, fixes } = entry.data;
            return (
              <li class="rounded-lg border border-border bg-surface p-6 md:p-8">
                <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border-subtle pb-4">
                  <div class="flex items-baseline gap-3">
                    <h2 class="text-2xl font-semibold text-foreground">
                      v{version}
                    </h2>
                    <span class="text-sm text-muted">
                      {formatDate(entry.data.date)}
                    </span>
                  </div>
                  <a
                    href={`https://github.com/jasonsoprovich/pq-companion/releases/tag/v${version}`}
                    target="_blank"
                    rel="noopener"
                    class="text-sm text-primary transition-colors hover:text-primary-hover"
                  >
                    View on GitHub →
                  </a>
                </div>

                {headline && (
                  <p
                    class="mt-4 text-base leading-relaxed text-foreground"
                    set:html={inlineMd(headline)}
                  />
                )}

                {highlights && highlights.length > 0 && (
                  <div class="mt-5">
                    <h3 class="text-sm font-medium uppercase tracking-[0.15em] text-primary">
                      Highlights
                    </h3>
                    <ul class="mt-3 space-y-2">
                      {highlights.map((h) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                          <span class="mt-1.5 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-primary" />
                          <span set:html={inlineMd(h)} />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {fixes && fixes.length > 0 && (
                  <div class="mt-5">
                    <h3 class="text-sm font-medium uppercase tracking-[0.15em] text-muted">
                      Fixes
                    </h3>
                    <ul class="mt-3 space-y-2">
                      {fixes.map((f) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                          <span class="mt-1.5 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-border" />
                          <span set:html={inlineMd(f)} />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ol>

      <div
        class="mt-12 rounded-lg border border-border bg-surface p-6 text-center"
      >
        <p class="text-base text-muted-foreground">
          The full commit-level history lives on GitHub.
        </p>
        <a
          href="https://github.com/jasonsoprovich/pq-companion/releases"
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center justify-center rounded-md border border-primary px-5 py-2.5 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
        >
          All releases on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
