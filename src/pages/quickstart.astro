---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    n: 1,
    title: "Download and install",
    body: "Grab the latest <code class=\"rounded bg-surface-2 px-1.5 py-0.5 text-primary\">PQ-Companion-Setup-x.x.x.exe</code> from GitHub and run it. The installer handles everything — no Go, Node, or Docker required. After install, PQ Companion auto-updates in the background.",
    cta: {
      href: "https://github.com/jasonsoprovich/pq-companion/releases/latest",
      label: "Latest release",
    },
  },
  {
    n: 2,
    title: "Point it at your Project Quarm folder",
    body: "On first launch, open <strong class=\"text-foreground\">Settings</strong> and set your Project Quarm install folder (the one containing <code class=\"rounded bg-surface-2 px-1.5 py-0.5 text-primary\">eqgame.exe</code>) and your character name. That's the entire setup — everything else is automatic.",
  },
  {
    n: 3,
    title: "Turn on the combat log in-game",
    body: "In Project Quarm, type <code class=\"rounded bg-surface-2 px-1.5 py-0.5 text-primary\">/log on</code> so the game writes your combat log to disk. The DPS meter, spell timers, NPC info overlay, and trigger engine all read from this file. No log = no live data.",
  },
  {
    n: 4,
    title: "(Recommended) Install Zeal",
    body: "<a href=\"https://github.com/iamclint/Zeal\" target=\"_blank\" rel=\"noopener\" class=\"text-primary hover:text-primary-hover\">Zeal</a> is a separate community project that exports your spellbook, inventory, AAs, and stats to JSON. PQ Companion uses these to power the Spell Checklist, Inventory Tracker, and Character Progression pages. The app still runs without Zeal — those features just won't have data.",
  },
  {
    n: 5,
    title: "Open the Overlay Dashboard",
    body: "From the sidebar, open <strong class=\"text-foreground\">Overlays</strong>. This is your one-stop dashboard — DPS, spell timers, NPC info, and trigger alerts in a single layout. Drag panels around to taste, then pop any of them out as a click-through transparent window above the game.",
  },
];

const next = [
  {
    title: "Database Explorer",
    body: "Press <kbd class=\"rounded border border-border bg-surface-2 px-1.5 py-0.5 text-xs text-primary\">Ctrl + K</kbd> from anywhere for global search across items, spells, NPCs, and zones.",
  },
  {
    title: "Custom Triggers",
    body: "Open <strong class=\"text-foreground\">Triggers</strong>, enable a built-in pack (e.g. enchanter mez/charm breaks), or run the import wizard to bring in GINA, EQNag, EQLogParser, or PQ Companion packs.",
  },
  {
    title: "Character Progression",
    body: "Once Zeal has exported, head to <strong class=\"text-foreground\">Character</strong> for stats, gear paper-doll, AA tracking, and a per-character to-do list.",
  },
  {
    title: "Config Backups",
    body: "Open <strong class=\"text-foreground\">Backups</strong> and snapshot your <code class=\"rounded bg-surface-2 px-1 py-0.5 text-primary\">.ini</code> files before any risky UI or hotkey change.",
  },
  {
    title: "Roll Tracker",
    body: "Open <strong class=\"text-foreground\">Roll Tracker</strong> during raid loot to bucket <code class=\"rounded bg-surface-2 px-1 py-0.5 text-primary\">/random</code> results per item, with optional auto-stop timers and Highest/Lowest winner rules.",
  },
  {
    title: "Players",
    body: "Open <strong class=\"text-foreground\">Players</strong> to see every player you've spotted in <code class=\"rounded bg-surface-2 px-1 py-0.5 text-primary\">/who</code> output — class, race, guild, last zone, level history. Anonymous sightings keep what you already knew about each player.",
  },
  {
    title: "Spellsets",
    body: "If Zeal is installed, open <strong class=\"text-foreground\">Spellsets</strong> to view and rename your saved spell layouts, or import another character's spellsets from their <code class=\"rounded bg-surface-2 px-1 py-0.5 text-primary\">.ini</code> file.",
  },
  {
    title: "Gear Upgrade Finder & Wishlist",
    body: "Open <strong class=\"text-foreground\">Gear Upgrade Finder</strong> for a per-slot, cap-aware ranking of real upgrades for your character — then star any suggestion (or any item from the database) onto a per-character wishlist that groups entries by slot with drag-to-reorder.",
  },
  {
    title: "Threat Meter",
    body: "Toggle <strong class=\"text-foreground\">Threat Meter</strong> in <strong class=\"text-foreground\">Overlays</strong> for a personal, per-mob hate estimate from your own combat log, with a live hate-per-second rate so you can feel when you're about to rip aggro.",
  },
  {
    title: "Resist Calculator",
    body: "Open <strong class=\"text-foreground\">Resist Calculator</strong> to estimate a spell's land chance against any NPC using Quarm's own resist math, including a resist-debuff section and a searchable target picker.",
  },
  {
    title: "Charm Pet Finder",
    body: "Charm class? Open <strong class=\"text-foreground\">Charm Pet Finder</strong> for a DPS-ranked list of charmable NPCs in a zone, with land-chance odds and level-cap warnings for your charm spell.",
  },
  {
    title: "Trader Tracker",
    body: "Selling in the Bazaar? Open <strong class=\"text-foreground\">Trader Tracker</strong> to see what sold while you were AFK — it infers sales by diffing your Trader's Satchel between inventory exports.",
  },
  {
    title: "Keys & Keyring",
    body: "Open <strong class=\"text-foreground\">Keys</strong> for a live per-character <code class=\"rounded bg-surface-2 px-1 py-0.5 text-primary\">/keys</code> snapshot plus a quest-based component checklist for VP, Sebilis, Howling Stones, Arx Seru, Sleeper's Tomb, Vex Thal, and more.",
  },
  {
    title: "Lockouts",
    body: "Run <code class=\"rounded bg-surface-2 px-1 py-0.5 text-primary\">/sll</code> in-game, then open <strong class=\"text-foreground\">Lockouts</strong> for live per-character countdowns on loot and legacy lockouts — so you know when an instance or flag is available again.",
  },
  {
    title: "CH Chain & Metronome",
    body: "Raiding with a Complete Heal chain? Toggle the <strong class=\"text-foreground\">CH Chain</strong> and <strong class=\"text-foreground\">CH Metronome</strong> panels in <strong class=\"text-foreground\">Overlays</strong> to track the rotation live from heal callouts — cast-to-land bars, measured cadence, and a stall warning before it breaks.",
  },
  {
    title: "Loot Tracker",
    body: "Open <strong class=\"text-foreground\">Loot</strong> for a running list of drops as they land. Click any drop to open the item's database entry, or jump straight to the source zone.",
  },
  {
    title: "Chat History",
    body: "Open <strong class=\"text-foreground\">Chat</strong> for a searchable, multi-channel log of your tells laid out as conversation threads, with per-character tabs.",
  },
  {
    title: "Move to a new PC",
    body: "Under <strong class=\"text-foreground\">Settings → Backups</strong>, use <strong class=\"text-foreground\">App Backup &amp; Restore</strong> to export your entire setup (settings, triggers, characters) to a single <code class=\"rounded bg-surface-2 px-1 py-0.5 text-primary\">.pqcb</code> bundle. Import on another machine to land exactly where you left off.",
  },
];
---

<BaseLayout
  title="Quick Start — PQ Companion"
  description="Get PQ Companion running with Project Quarm in five minutes: install, point it at your game folder, turn on /log, and open the Overlay Dashboard."
>
  <section class="hero-glow border-b border-border-subtle">
    <div class="mx-auto max-w-4xl px-6 pb-16 pt-20 md:pt-24">
      <p
        class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-primary"
      >
        Quick Start
      </p>
      <h1
        class="text-4xl font-bold tracking-tight text-foreground md:text-5xl"
      >
        Up and running in five minutes.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted-foreground">
        Five short steps from a fresh install to a running Overlay
        Dashboard. If you get stuck, the
        <a href="/help" class="text-primary hover:text-primary-hover"
          >full help doc</a
        > has a section per feature with prerequisites and gotchas.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-3xl px-6">
      <ol class="space-y-10">
        {
          steps.map((s) => (
            <li class="rounded-lg border border-border bg-surface p-6 md:p-8">
              <div class="flex items-start gap-5">
                <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-primary text-sm font-semibold text-primary">
                  {s.n}
                </span>
                <div class="flex-1">
                  <h2 class="text-xl font-semibold text-foreground">
                    {s.title}
                  </h2>
                  <p
                    class="mt-3 text-base leading-relaxed text-muted-foreground"
                    set:html={s.body}
                  />
                  {s.cta && (
                    <a
                      href={s.cta.href}
                      target="_blank"
                      rel="noopener"
                      class="mt-5 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
                    >
                      {s.cta.label}
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="my-14 divider-gold"></div>

      <h2 class="text-2xl font-semibold text-foreground">
        Where to go next
      </h2>
      <p class="mt-3 text-base text-muted-foreground">
        Once the dashboard is up, these are the next places worth poking
        around.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          next.map((n) => (
            <li class="rounded-lg border border-border bg-surface p-5">
              <h3 class="text-base font-semibold text-primary">
                {n.title}
              </h3>
              <p
                class="mt-2 text-sm leading-relaxed text-muted-foreground"
                set:html={n.body}
              />
            </li>
          ))
        }
      </ul>

      <div
        class="mt-12 rounded-lg border border-border bg-surface p-6 text-center"
      >
        <p class="text-base text-muted-foreground">
          Want the full reference, with every feature and every config
          knob?
        </p>
        <a
          href="/help"
          class="mt-4 inline-flex items-center justify-center rounded-md border border-primary px-5 py-2.5 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
        >
          Read the help doc
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
