---
import { resolveMedia } from "../lib/media";

interface Props {
  title: string;
  tagline: string;
  description: string;
  bullets?: string[];
  mediaSlug: string;
  reversed?: boolean;
  alt?: string;
  /** When true, render the text full-width with no media column/placeholder. */
  noMedia?: boolean;
}

const {
  title,
  tagline,
  description,
  bullets = [],
  mediaSlug,
  reversed = false,
  alt,
  noMedia = false,
} = Astro.props;

const media = resolveMedia(mediaSlug);
const altText = alt ?? `${title} demo`;
---

<article
  class:list={[
    !noMedia && "grid gap-8 md:grid-cols-2 md:items-center md:gap-12",
    !noMedia && reversed && "md:[&>*:first-child]:order-2",
  ]}
>
  <div>
    <p
      class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-primary"
    >
      {tagline}
    </p>
    <h3 class="text-2xl font-semibold text-foreground md:text-3xl">
      {title}
    </h3>
    <p class="mt-4 text-base leading-relaxed text-muted-foreground">
      {description}
    </p>
    {
      bullets.length > 0 && (
        <ul class="mt-5 space-y-2">
          {bullets.map((b) => (
            <li class="flex items-start gap-3 text-sm leading-6 text-muted-foreground">
              <span aria-hidden="true" class="flex-shrink-0 leading-6 text-primary">▸</span>
              <span class="leading-6">{b}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {!noMedia && (
  <div
    class="aspect-video overflow-hidden rounded-lg border border-border bg-surface shadow-xl shadow-black/40"
  >
    {
      media?.kind === "video" && (
        <video
          data-lazy-src={media.src}
          loop
          muted
          playsinline
          preload="none"
          class="h-full w-full object-cover"
        />
      )
    }
    {
      media?.kind === "image" && (
        <img
          src={media.src}
          alt={altText}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      )
    }
    {
      !media && (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface to-surface-2">
          <div class="px-6 text-center">
            <div class="mx-auto mb-2 text-3xl text-primary opacity-50">▶</div>
            <p class="text-xs text-muted-foreground">Demo placeholder</p>
            <p class="mt-1 text-[10px] text-muted">
              Drop an image or video at
              {" "}
              <code class="rounded bg-surface-2 px-1 py-0.5 text-primary">
                public/media/{mediaSlug}.{`{mp4,webm,png,jpg,webp,gif}`}
              </code>
            </p>
          </div>
        </div>
      )
    }
  </div>
  )}
</article>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>("video[data-lazy-src]");

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          const src = video.dataset.lazySrc;
          if (src && !video.src) {
            video.src = src;
          }
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    },
    { rootMargin: "200px 0px", threshold: 0.1 },
  );

  for (const video of videos) {
    observer.observe(video);
  }
</script>
