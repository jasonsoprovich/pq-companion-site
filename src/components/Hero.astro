---

---

<section class="hero-glow relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 pb-20 pt-24 md:pt-32">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-primary"
      >
        For Project Quarm
      </p>
      <h1
        class="text-4xl font-bold tracking-tight text-foreground md:text-6xl"
      >
        The desktop companion <br class="hidden md:block" />
        EverQuest forgot to ship.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
        Database explorer, DPS meter, spell timers, NPC info overlay,
        spell checklist, and a custom trigger engine — all in one
        lightweight app that runs alongside the game.
      </p>

      <div
        class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <a
          href="https://github.com/jasonsoprovich/pq-companion/releases/latest"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
        >
          Download for Windows
        </a>
        <a
          href="https://github.com/jasonsoprovich/pq-companion"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-6 py-3 text-base font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
        >
          View on GitHub
        </a>
      </div>

      <p class="mt-4 text-xs text-muted">
        Free &amp; open source · Auto-updates · Windows 10/11
      </p>
    </div>

    <!-- Hero video placeholder -->
    <div
      class="mx-auto mt-16 aspect-video w-full max-w-5xl overflow-hidden rounded-lg border border-border bg-surface shadow-2xl shadow-black/50"
    >
      <div
        class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface to-surface-2"
      >
        <div class="text-center">
          <div class="mx-auto mb-3 text-5xl text-primary opacity-60">▶</div>
          <p class="text-sm text-muted-foreground">
            Hero demo video placeholder
          </p>
          <p class="mt-1 text-xs text-muted">
            Drop your screenshare/MP4 in <code
              class="rounded bg-surface-2 px-1.5 py-0.5 text-primary"
              >public/media/hero.mp4</code
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
