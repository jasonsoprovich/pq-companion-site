---
import FeatureCard from "./FeatureCard.astro";

const features = [
  {
    title: "Database Explorer",
    tagline: "Search anything",
    description:
      "Every item, spell, NPC, and zone in the Project Quarm database — fully searchable with filters that actually work. Item icons, spell icons, click-through cross-references between scrolls and the spells they teach, NPC drops linking to source mobs, and full zone NPC rosters. Press Cmd/Ctrl-K from anywhere for global search.",
    bullets: [
      "Advanced item filters: race, class, level, slot, type, stat thresholds",
      "Spell filters by class and level; hides NPC-only spells",
      "Zone tabs for connected zones, drops, ground spawns, and forage",
    ],
    mediaSlug: "database-explorer",
  },
  {
    title: "DPS Meter & Combat Log",
    tagline: "Live combat tracking",
    description:
      "A transparent, always-on-top overlay floating above the game with live damage output for you and your group. Pet and charm damage rolls up under the owner. Boss fights stay grouped instead of fragmenting. Copy any fight or session summary to clipboard for guild chat.",
    bullets: [
      "Per-fight and session-wide totals, with full combat history",
      "Click any combatant to expand their full damage breakdown",
      "One-click copy of fight or session summary for /gu and /tell",
    ],
    mediaSlug: "dps-meter",
  },
  {
    title: "Spell Timer Engine",
    tagline: "Never miss a re-cast",
    description:
      "Tick-accurate countdown bars for every buff, debuff, mez, stun, and DoT — driven directly from your live combat log with target-aware keying. Separate overlay windows for buffs and detrimentals. Configurable audio and TTS alerts when timers cross your thresholds.",
    bullets: [
      "Per-category display thresholds with per-trigger overrides",
      "Tracking scope: just yourself, or anyone in your group",
      "Target name shown on every row; auto-cancels on resist or dispel",
    ],
    mediaSlug: "spell-timers",
  },
  {
    title: "NPC Info Overlay",
    tagline: "Know your target",
    description:
      "The moment you consider a mob, the overlay shows its level, class, HP, resists, body type, and special abilities — Summon, Unmezzable, Uncharmable, See Invis, Enrage, Flurry. Pulled straight from the database via your combat log.",
    bullets: [
      "Auto-detects target from melee and spell events",
      "Special-ability badges and resist breakdown at a glance",
      "Faction, body type, and zone context in one panel",
    ],
    mediaSlug: "npc-info",
  },
  {
    title: "Character Progression",
    tagline: "Stats, gear, AAs, to-dos",
    description:
      "A full per-character workspace driven by Zeal exports. Stats panel with base HP/Mana, stat caps, worn effects, and softcap AC. Paper-doll gear view with bag and bank cards. AA tracking split into trained vs. available, with descriptions. A per-character to-do list with subtasks for tracking goals.",
    bullets: [
      "Spell Modifiers tab — see every focus and worn effect that's modifying your spells",
      "AA tracking: trained ranks, untrained candidates, and cost-aware planning",
      "Character switcher syncs across the app; sub-tabs on every tracker page",
    ],
    mediaSlug: "character-progression",
  },
  {
    title: "Spell Checklist",
    tagline: "Know what you're missing",
    description:
      "Cross-references every spell your class can learn against your Zeal-exported spellbook so you always know exactly which spells you still need to scribe. Filterable, level-aware, and updated whenever Zeal exports.",
    bullets: [
      "Filters by class and level range",
      "Hides NPC-only and unobtainable spells",
      "Click any spell to jump to its database entry",
    ],
    mediaSlug: "spell-checklist",
  },
  {
    title: "Inventory & Key Tracker",
    tagline: "Across all your characters",
    description:
      "All inventory across every character in one searchable view, with item icons everywhere — equipped, bags, bank, shared bank. Paper-doll layout with collapsible bag and bank cards. Click any item to open its full database entry in a modal without leaving the page.",
    bullets: [
      "One search box across every character's full inventory",
      "Per-key component checklist for VP, Sebilis, Howling Stones, and more",
      "Auto-detects intermediate combines (e.g. Vex Thal keys) as you progress",
    ],
    mediaSlug: "inventory-tracker",
  },
  {
    title: "Custom Triggers & Alerts",
    tagline: "GINA-style, but local",
    description:
      "A regex trigger engine for any log line. Each trigger fires one or more actions: on-screen text alerts (with draggable position and font size), local sound files, or text-to-speech. Built-in packs for enchanters (mez/charm breaks, debuffs, raid buffs) and group awareness (tells, deaths). Import GINA packs as JSON.",
    bullets: [
      "Drag-to-position overlay text with live test buttons",
      "Native file picker for sound files; per-action volume control",
      "Always-on event alerts for deaths, zoning, resists, and interrupts",
    ],
    mediaSlug: "triggers",
  },
  {
    title: "Customizable Overlay Dashboard",
    tagline: "Lay it out your way",
    description:
      "A single Overlays page brings DPS, spell timers, NPC info, and triggers together with a snap-grid dashboard. Drag panels into the layout you want, resize them, and the arrangement persists across sessions. Each panel can also pop out as its own click-through, transparent window above the game.",
    bullets: [
      "Snap-grid drag-and-drop with persistent layout",
      "Click-through transparent windows when popped out",
      "Lock toggle and remembered window size and position per overlay",
    ],
    mediaSlug: "overlays-dashboard",
  },
  {
    title: "Config Backup Manager",
    tagline: "Snapshot & restore",
    description:
      "One-click backup and restore for every EverQuest .ini config file. Snapshot before risky changes, roll back instantly if something breaks. Auto-backs up your files on a custom schedule or whenever they change.",
    bullets: [
      "Auto-backups on a custom schedule or on file change",
      "Snapshots all UI, hotkey, and social config",
      "Browse, label, and restore previous backups",
    ],
    mediaSlug: "backup-manager",
  },
];
---

<section id="features" class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-16 text-center">
      <p
        class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-primary"
      >
        Features
      </p>
      <h2
        class="text-3xl font-bold tracking-tight text-foreground md:text-4xl"
      >
        Everything you wish was built into the client
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-muted-foreground">
        PQ Companion reads your combat log and Zeal exports to add the
        kind of quality-of-life features modern MMOs ship by default —
        right at your fingertips while you play.
      </p>
    </div>

    <div class="space-y-20">
      {
        features.map((f, i) => (
          <FeatureCard
            title={f.title}
            tagline={f.tagline}
            description={f.description}
            bullets={f.bullets}
            mediaSlug={f.mediaSlug}
            reversed={i % 2 === 1}
          />
        ))
      }
    </div>
  </div>
</section>
