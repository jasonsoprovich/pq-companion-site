---

---

<section id="download" class="py-20">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <p
      class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-primary"
    >
      Download
    </p>
    <h2
      class="text-3xl font-bold tracking-tight text-foreground md:text-4xl"
    >
      Get PQ Companion
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-base text-muted-foreground">
      Free, open source, and auto-updating. Windows 10/11 only.
    </p>

    <div
      class="mx-auto mt-10 max-w-2xl rounded-lg border border-border bg-surface p-8 text-left"
    >
      <div class="flex items-start justify-between gap-6">
        <div>
          <h3 class="text-lg font-semibold text-foreground">
            Windows installer
          </h3>
          <p class="mt-2 text-sm text-muted-foreground">
            Grab <code
              class="rounded bg-surface-2 px-1.5 py-0.5 text-primary"
              >PQ-Companion-Setup-x.x.x.exe</code
            > from the latest release. The installer handles everything;
            no Go, Node, or Docker required.
          </p>
        </div>
        <a
          href="https://github.com/jasonsoprovich/pq-companion/releases/latest"
          target="_blank"
          rel="noopener"
          class="flex-shrink-0 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
        >
          Latest release
        </a>
      </div>

      <div class="my-6 divider-gold"></div>

      <h4 class="text-sm font-semibold text-foreground">After install</h4>
      <ol
        class="mt-3 space-y-2 text-sm text-muted-foreground [counter-reset:step]"
      >
        <li class="flex gap-3">
          <span
            class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-primary text-xs font-semibold text-primary"
            >1</span
          >
          <span>
            Open <strong class="text-foreground">Settings</strong> and set
            your Project Quarm folder + character name.
          </span>
        </li>
        <li class="flex gap-3">
          <span
            class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-primary text-xs font-semibold text-primary"
            >2</span
          >
          <span>
            In-game, type <code
              class="rounded bg-surface-2 px-1.5 py-0.5 text-primary"
              >/log on</code
            > so the game writes your combat log.
          </span>
        </li>
        <li class="flex gap-3">
          <span
            class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-primary text-xs font-semibold text-primary"
            >3</span
          >
          <span>
            (Recommended) Install <a
              href="https://github.com/iamclint/Zeal"
              target="_blank"
              rel="noopener"
              class="text-primary hover:text-primary-hover">Zeal</a
            > so the spell checklist and inventory tracker can read your
            spellbook + bags.
          </span>
        </li>
      </ol>
    </div>
  </div>
</section>
